<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
	<Compile Remove="Cs\BCL\**\*.cs" />
    <EmbeddedResource Include="Cs\BCL\**\*.cs" Pack="true" />
	<EmbeddedResource Include="C\StandardLibrary\**\*.h" Pack="true" />
	<EmbeddedResource Include="C\StandardLibrary\**\*.c" Pack="true" />
	<EmbeddedResource Include="Targets\riscv\boot\**\*.s" Pack="true" />
	<EmbeddedResource Include="Targets\riscv\os\**\*.c" Pack="true" />
	<EmbeddedResource Include="Cs\Backend\CLR\**\*.c" Pack="true" />
	<EmbeddedResource Include="Py\stdlib\**\*.py"/>
  </ItemGroup>

  <PropertyGroup>
    <PackageId>Cnidaria</PackageId>
    <Version>3.0.0</Version>
    <Authors>equmag</Authors>
    <Description>Lightweight RCE safe compiler collection</Description>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)nuget</PackageOutputPath>
  </PropertyGroup>
</Project>
